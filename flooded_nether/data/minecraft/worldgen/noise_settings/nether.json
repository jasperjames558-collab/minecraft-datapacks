{
  "sea_level": 128,
  "disable_mob_generation": false,
  "aquifers_enabled": false,
  "ore_veins_enabled": false,
  "legacy_random_source": false,
  "default_block": { "Name": "minecraft:netherrack" },
  "default_fluid": { "Name": "minecraft:water", "Properties": { "level": "0" } },
  "noise": { "min_y": 0, "height": 256, "size_horizontal": 1, "size_vertical": 2 },
  "spawn_target": [],
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": 0,
    "temperature": "minecraft:nether/temperature",
    "vegetation": "minecraft:nether/vegetation",
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "initial_density_without_jaggedness": "minecraft:nether/initial_density_without_jaggedness",
    "final_density": "minecraft:nether/base_3d_noise",
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0
  },
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:vertical_gradient", "random_name": "minecraft:bedrock_floor", "true_at_and_below": { "absolute": 0 }, "false_at_and_above": { "absolute": 5 } },
        "then_run": { "type": "minecraft:block", "result_state": { "Name": "minecraft:bedrock" } }
      },
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:vertical_gradient", "random_name": "minecraft:bedrock_roof", "true_at_and_below": { "absolute": 122 }, "false_at_and_above": { "absolute": 127 } },
        "then_run": { "type": "minecraft:block", "result_state": { "Name": "minecraft:bedrock" } }
      },
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:stone_depth", "offset": 0, "add_stone_depth": false, "secondary_depth_range": 0, "surface_type": "floor" },
        "then_run": { "type": "minecraft:sequence", "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": { "type": "minecraft:biome", "biome_is": ["minecraft:soul_sand_valley"] },
            "then_run": { "type": "minecraft:sequence", "sequence": [
              { "type": "minecraft:condition", "if_true": { "type": "minecraft:noise_threshold", "noise": "minecraft:soul_sand_layer", "min_threshold": -0.012, "max_threshold": 1.7976931348623157e308 }, "then_run": { "type": "minecraft:block", "result_state": { "Name": "minecraft:soul_sand" } } },
              { "type": "minecraft:block", "result_state": { "Name": "minecraft:soul_soil" } }
            ]}
          },
          {
            "type": "minecraft:condition",
            "if_true": { "type": "minecraft:biome", "biome_is": ["minecraft:basalt_deltas"] },
            "then_run": { "type": "minecraft:sequence", "sequence": [
              { "type": "minecraft:condition", "if_true": { "type": "minecraft:noise_threshold", "noise": "minecraft:basalt_surface", "min_threshold": -0.765, "max_threshold": 1.7976931348623157e308 }, "then_run": { "type": "minecraft:block", "result_state": { "Name": "minecraft:basalt", "Properties": { "axis": "y" } } } },
              { "type": "minecraft:block", "result_state": { "Name": "minecraft:blackstone" } }
            ]}
          },
          { "type": "minecraft:block", "result_state": { "Name": "minecraft:netherrack" } }
        ]}
      },
      {
        "type": "minecraft:condition",
        "if_true": { "type": "minecraft:stone_depth", "offset": 0, "add_stone_depth": false, "secondary_depth_range": 0, "surface_type": "ceiling" },
        "then_run": { "type": "minecraft:sequence", "sequence": [
          { "type": "minecraft:condition", "if_true": { "type": "minecraft:biome", "biome_is": ["minecraft:basalt_deltas"] }, "then_run": { "type": "minecraft:block", "result_state": { "Name": "minecraft:basalt", "Properties": { "axis": "y" } } } },
          { "type": "minecraft:block", "result_state": { "Name": "minecraft:netherrack" } }
        ]}
      }
    ]
  }
}
